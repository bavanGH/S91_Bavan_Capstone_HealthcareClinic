meta {
  name: Create patient treatment
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/patients/{{patientId}}/treatments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

