meta {
  name: Create patient
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/patients
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "patientId": "PT-0001",
    "firstName": "Ava",
    "lastName": "Thompson",
    "age": 34,
    "gender": "Female",
    "phone": "+1-555-0100",
    "email": "ava@example.com"
  }
}
